[Unit]
Description=Collect Wazuh manager and indexer health snapshot
After=wazuh-manager.service wazuh-indexer.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wazuh-health-collect
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/www/wazuh-health
